# NEVER commit a real `.env` file — it is already listed in .gitignore.

# -- General
APP_NAME="Multi-Agent Orchestration API"
ENVIRONMENT=development
DEBUG=true

# -- Security
# Comma-separated list of accepted API keys for the X-API-Key header.
API_KEYS=local-dev-key
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30

# -- LLM provider 
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=1024

# -- Caching (optional; falls back to in-memory if unset)
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# -- Orchestration
MAX_AGENT_STEPS=5
MAX_INPUT_CHARS=8000

# -- Logging 
LOG_LEVEL=INFO
LOG_JSON=true
